<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculadora.MainPage">

    <Grid RowDefinitions="*, 2*, 4*" Padding="20">
        
        <VerticalStackLayout Grid.Row="1" VerticalOptions="End" Spacing="5">
            <Label x:Name="lblPantalla" 
                   Text="0" 
                   HorizontalTextAlignment="End" 
                   TextColor="White" 
                   FontSize="48" 
                   FontAttributes="Bold"/>
        </VerticalStackLayout>

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" RowDefinitions="*,*,*,*,*" ColumnSpacing="10" RowSpacing="10" Margin="0,20,0,0">
 
            <Button Text="AC" Clicked="OnAcClicked" BackgroundColor="#333333" TextColor="Orange" FontSize="20" Grid.Row="0" Grid.Column="0"/>
            <Button Text="⌫" Clicked="OnBorrarUltimoClicked" BackgroundColor="#333333" TextColor="Orange" FontSize="20" Grid.Row="0" Grid.Column="1"/>
            <Button Text="%" Clicked="OnOperadorClicked" CommandParameter="%" BackgroundColor="#333333" TextColor="Orange" FontSize="20" Grid.Row="0" Grid.Column="2"/>
            <Button Text="÷" Clicked="OnOperadorClicked" CommandParameter="÷" BackgroundColor="#FF9500" TextColor="White" FontSize="24" Grid.Row="0" Grid.Column="3"/>

            <Button Text="7" Clicked="OnNumeroClicked" CommandParameter="7" BackgroundColor="#2C2C2C" TextColor="White" FontSize="24" Grid.Row="1" Grid.Column="0"/>
            <Button Text="8" Clicked="OnNumeroClicked" CommandParameter="8" BackgroundColor="#2C2C2C" TextColor="White" FontSize="24" Grid.Row="1" Grid.Column="1"/>
            <Button Text="9" Clicked="OnNumeroClicked" CommandParameter="9" BackgroundColor="#2C2C2C" TextColor="White" FontSize="24" Grid.Row="1" Grid.Column="2"/>
            <Button Text="×" Clicked="OnOperadorClicked" CommandParameter="×" BackgroundColor="#FF9500" TextColor="White" FontSize="24" Grid.Row="1" Grid.Column="3"/>

            <Button Text="4" Clicked="OnNumeroClicked" CommandParameter="4" BackgroundColor="#2C2C2C" TextColor="White" FontSize="24" Grid.Row="2" Grid.Column="0"/>
            <Button Text="5" Clicked="OnNumeroClicked" CommandParameter="5" BackgroundColor="#2C2C2C" TextColor="White" FontSize="24" Grid.Row="2" Grid.Column="1"/>
            <Button Text="6" Clicked="OnNumeroClicked" CommandParameter="6" BackgroundColor="#2C2C2C" TextColor="White" FontSize="24" Grid.Row="2" Grid.Column="2"/>
            <Button Text="-" Clicked="OnOperadorClicked" CommandParameter="-" BackgroundColor="#FF9500" TextColor="White" FontSize="24" Grid.Row="2" Grid.Column="3"/>

            <Button Text="1" Clicked="OnNumeroClicked" CommandParameter="1" BackgroundColor="#2C2C2C" TextColor="White" FontSize="24" Grid.Row="3" Grid.Column="0"/>
            <Button Text="2" Clicked="OnNumeroClicked" CommandParameter="2" BackgroundColor="#2C2C2C" TextColor="White" FontSize="24" Grid.Row="3" Grid.Column="1"/>
            <Button Text="3" Clicked="OnNumeroClicked" CommandParameter="3" BackgroundColor="#2C2C2C" TextColor="White" FontSize="24" Grid.Row="3" Grid.Column="2"/>
            <Button Text="+" Clicked="OnOperadorClicked" CommandParameter="+" BackgroundColor="#FF9500" TextColor="White" FontSize="24" Grid.Row="3" Grid.Column="3"/>

            <Button Text="0" Clicked="OnNumeroClicked" CommandParameter="0" BackgroundColor="#2C2C2C" TextColor="White" FontSize="24" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"/>
            <Button Text="." Clicked="OnPuntoClicked" BackgroundColor="#2C2C2C" TextColor="White" FontSize="24" Grid.Row="4" Grid.Column="2"/>
            <Button Text="=" Clicked="OnIgualClicked" BackgroundColor="#FF9500" TextColor="White" FontSize="24" Grid.Row="4" Grid.Column="3"/>
        </Grid>
    </Grid>
</ContentPage>
